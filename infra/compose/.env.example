# Optional local Compose settings.
# Compose provides defaults, so you can run infra/compose/docker-compose.yml without a .env file.
# Keep every password value in the changeme_local_only form.

POSTGRES_DB=mnemograph
POSTGRES_USER=mnemograph
POSTGRES_PASSWORD=changeme_local_only
POSTGRES_PORT=5432
VALKEY_PORT=6379
MINIO_ROOT_USER=mnemograph
MINIO_ROOT_PASSWORD=changeme_local_only
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
